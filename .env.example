# === Kiosk Configuration ===

# --- Immich ---
IMMICH_URL=https://photos.yourdomain.com
IMMICH_SHARED_LINK_KEY=your-shared-link-key-here
IMMICH_THUMB_SIZE=large

# --- Google Calendar ---
# Schedule view (AGENDA mode), expanded to fill the iframe area.
# Make your calendar public, then get the embed URL from Google Calendar settings.
GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/embed?src=en.usa%23holiday%40group.v.calendar.google.com&ctz=America%2FChicago&mode=AGENDA&showTitle=0&showPrint=0&showTabs=0&showCalendars=0&showTz=0&showNav=0&showDate=0
CALENDAR_SCALE=2
CALENDAR_INVERT=true

# --- Display timing (in minutes) ---
SLIDESHOW_INTERVAL_MINUTES=15
PAGE_REFRESH_INTERVAL_MINUTES=30
CALENDAR_REFRESH_INTERVAL_MINUTES=30

# --- Web server ---
WEB_PORT=8080
# Bind address (use 127.0.0.1 if behind reverse proxy, 0.0.0.0 for direct access)
WEB_HOST=0.0.0.0

# === Reverse Proxy Configuration ===
# Set to true if running behind Nginx/Traefik/etc.
# This enables root_path and removes X-Frame-Options for kiosk embedding.
TRUST_PROXY=false

# If behind a reverse proxy, set this to the public-facing URL (with path if applicable).
# Example: https://kiosk.yourdomain.com
BASE_URL=

# === Data Storage & Cache ===
# Data directory inside the container (mapped to host path via docker-compose volumes).
# On the Docker host, this maps to: ${DATA_PATH_HOST:-/root/docker/kiosk/data}
DATA_PATH=/app/data

# Local thumbnail cache size limit (in MB). Photos are cached to avoid CORS issues.
CACHE_MAX_SIZE_MB=1024

# Cache entry TTL in seconds (default 24h).
CACHE_MAX_AGE_SECONDS=86400

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
# Log directory inside the container (mapped to host via docker-compose volumes).
LOG_DIR=/app/logs

# === Kiosk Configuration ===

# --- Immich ---
IMMICH_URL=https://photos.yourdomain.com
IMMICH_SHARED_LINK_KEY=your-shared-link-key-here
IMMICH_THUMB_SIZE=large

# --- Google Calendar ---
# Make your calendar public, then get the embed URL from Google Calendar settings.
GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/embed?src=d1hts4hbba10stq9eg2r0r52o8%40group.calendar.google.com&ctz=America%2FChicago

# --- Display timing (in minutes) ---
SLIDESHOW_INTERVAL_MINUTES=15
PAGE_REFRESH_INTERVAL_MINUTES=30
CALENDAR_REFRESH_INTERVAL_MINUTES=30

# --- Web server ---
WEB_PORT=8080

# === Reverse Proxy Configuration ===
# Set to true if running behind Nginx/Traefik/etc.
# This enables root_path and removes X-Frame-Options for kiosk embedding.
TRUST_PROXY=false

# If behind a reverse proxy, set this to the public-facing URL.
# Example: https://kiosk.yourdomain.com
BASE_URL=

# === Data Storage ===
# Host paths for persistent data (create directories before first run).
# Default points to /root/docker/kiosk on the Docker host.
DATA_PATH=/root/docker/kiosk/data
CACHE_PATH=/root/docker/kiosk/cache